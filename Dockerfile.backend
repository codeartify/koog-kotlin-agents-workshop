FROM eclipse-temurin:25-jdk AS build

ARG MODULE
ARG ARTIFACT_ID
WORKDIR /workspace

COPY . .
RUN chmod +x mvnw \
    && ./mvnw -B -ntp -Ddocker.compose.skip=true -DskipTests -pl "${MODULE}" -am package \
    && cp "${MODULE}/target/${ARTIFACT_ID}-0.0.1-SNAPSHOT.jar" /workspace/app.jar

FROM eclipse-temurin:25-jre
WORKDIR /app
COPY --from=build /workspace/app.jar app.jar
ENTRYPOINT ["java", "-jar", "/app/app.jar"]
